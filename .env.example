# ============================================================================
# CLOSET BY ERA - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.local for local development
# For production, set these in your hosting provider's environment settings

# ============================================================================
# SUPABASE (Required)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key for server-side operations (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# UPSTASH REDIS (Optional - for production rate limiting)
# ============================================================================
# Create a free database at https://upstash.com
# Without these, rate limiting falls back to in-memory (not recommended for production)
UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ============================================
# EMAIL (all emails use the store template, sent with Nodemailer over SMTP)
# ============================================
# Providers are tried in this order; if one fails the next is used.
EMAIL_PROVIDERS=brevo,resend,smtp

# Sender for every email. Verify this domain with each provider you enable.
EMAIL_FROM=orders@your-domain.com
EMAIL_FROM_NAME=Closet By Era

# Brevo: Settings > SMTP & API > SMTP (login looks like xxxx@smtp-brevo.com)
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# BREVO_SMTP_PORT=587

# Resend: API Keys (sent through smtp.resend.com:465)
RESEND_API_KEY=

# Any other SMTP server (Gmail app password, Outlook, your host, MailDev for tests)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Supabase Auth > Hooks > Send Email (HTTPS): https://<site>/api/webhooks/confirmation-email
# Paste the generated secret (v1,whsec_...). Sends sign-up, reset and security emails.
SEND_EMAIL_HOOK_SECRET=

# ============================================
# PAYMENTS
# ============================================
# Stripe (test mode): Dashboard > Developers > API keys, then a webhook endpoint
# https://<site>/api/webhooks/stripe for checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# checkout.session.expired. Live keys are ignored unless STRIPE_ALLOW_LIVE=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# SITE
# ============================================
# Public URL used in emails (defaults to the Vercel production domain).
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# WhatsApp chat button and payment-proof link, international digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=


# ============================================================================
# OPENAI (Optional - for AI Stylist feature)
# ============================================================================
OPENAI_API_KEY=sk-your-openai-key

# ============================================================================
# ADMIN ACCESS
# ============================================================================
ADMIN_EMAIL=admin@closetbyera.com
ADMIN_PASSWORD=your-secure-password
