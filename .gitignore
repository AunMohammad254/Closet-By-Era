# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# PWA service worker (generated by @ducanh2912/next-pwa on every build)
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/workbox-*.js.map
/public/swe-worker-*.js
/public/fallback-*.js

# Bun is the package manager: keep bun.lock, never commit other lockfiles
package-lock.json
yarn.lock
pnpm-lock.yaml

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
SQL/
SQL/supabase_schema.sql

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

#Docs
docs/

#errors
errors/

# Temporary/generated files
*.log
build-*.txt
lint_*.txt
scripts/

playwright-report/
test-results/
